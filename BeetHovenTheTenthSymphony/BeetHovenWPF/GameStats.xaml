<Window x:Class="BeetHovenWPF.GameStats"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:local="clr-namespace:BeetHovenWPF"
        mc:Ignorable="d"
        Title="GameStats" Height="857" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,5">
            <TextBlock Text="Played songs" FontSize="24" FontWeight="Bold"/>
        </StackPanel>

        <!-- Played Songs -->
        <Border Grid.Row="1" BorderBrush="Black" BorderThickness="1" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding AmountOfSongs}" FontSize="24" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="Total" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding AmountOfSongsThisWeek}" FontSize="24" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="This week" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding AmountOfSongsThisMonth}" FontSize="24" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="This month" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,25,0,10">
            <TextBlock Text="Hours played" FontSize="24" FontWeight="Bold"/>
        </StackPanel>

        <!-- Hours Played -->
        <Border Grid.Row="3" BorderBrush="Black" BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding AmountOfHours}" FontSize="24" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="Total" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding AmountOfHoursThisWeek}" FontSize="24" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="This week" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding AmountOfHoursThisMonth}" FontSize="24" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="This month" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Last played info -->
        <StackPanel Grid.Row="4" Margin="0,25,0,0">
            <TextBlock FontSize="24" FontWeight="Bold">
                <Run Text="Last played song: " />
                <Run Text=" "/><Run Text="{Binding LastPlayedSong}" />
            </TextBlock>
        </StackPanel>

        <Grid Grid.Row="5" Margin="0,75,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!--All Scores-->
            <Border Grid.Row="0" Grid.Column="0" BorderBrush="Black" BorderThickness="1" Margin="5" Padding="5">
                <StackPanel>
                    <TextBlock Text="All scores" FontSize="20" FontWeight="Bold"/>
                    <ListBox x:Name="ScoreListBox" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!--General-->
            <Border Grid.Row="0" Grid.Column="1" BorderBrush="Black" BorderThickness="1" Margin="5" Padding="5">
                <StackPanel>
                    <TextBlock Text="General" FontWeight="Bold" FontSize="20"/>
                    <TextBlock FontSize="16">
                        <Run Text="Duur sessie: " />
                        <Run Text="{Binding session.Duration}" />
                    </TextBlock>
                    <TextBlock FontSize="16">
                        <Run Text="Score: " />
                        <Run Text="{Binding LastScore}" />
                    </TextBlock>
                    <TextBlock FontSize="16">
                        <Run Text="Gemiddelde tijd in sessies: " />
                        <Run Text="{Binding AverageTimeSession}" />
                        <Run Text=" minuten." />
                    </TextBlock>
                    <TextBlock FontSize="16">
                        <Run Text="Duur lied: " />
                        <Run Text="{Binding DurationSong}" />
                        <Run Text=" minuten." />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!--Notes played-->
            <Border Grid.Row="1" Grid.Column="0" BorderBrush="Black" BorderThickness="1" Margin="5" Padding="5">
                <StackPanel>
                    <TextBlock FontSize="20" FontWeight="Bold">
                        <Run Text="Noten:"/>
                        <Run Text="                    " />
                        <Run Text="Aantal:"/>
                    </TextBlock>
                    <ListBox ItemsSource="{Binding Notes}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="{Binding Key, Mode=OneWay}" />
                                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" Text="{Binding Value, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!--Highscores-->
            <Border Grid.Row="1" Grid.Column="1" BorderBrush="Black" BorderThickness="1" Margin="5" Padding="5">
                <StackPanel>
                    <TextBlock Text="Highscores" FontSize="20" FontWeight="Bold"/>
                    <ListBox ItemsSource="{Binding HighScores}" AlternationCount="100">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex)}" />
                                    <TextBlock Text=": " Margin="5,0,0,0"/>
                                    <TextBlock Text="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </StackPanel>
            </Border>
        </Grid>
    </Grid>

</Window>